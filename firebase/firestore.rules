rules_version = '2';

// ── Reglas de Firestore para HemoPocket ──
// Dos colecciones:
//   roles/{uid}  → { role: "admin" }  ó  { role: "editor", sections: ["bs","th", ...] }
//   guias/{id}   → { section, subtype, name, path, updatedAt, uploadedBy }
//
// Lectura de guías: solo usuarios AUTORIZADOS (admin/editor, cuenta aprobada, o
//   usuario heredado sin ficha de cuenta). Ver función isApproved().
// Escritura de guías: admin (cualquier sección) o editor de ESA sección.
// La colección roles se gestiona desde la consola; el cliente no la escribe.

service cloud.firestore {
  match /databases/{database}/documents {

    function roleData() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }
    function hasRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }
    function isAdmin() {
      return hasRole() && roleData().role == 'admin';
    }
    // ¿Puede el usuario actual editar guías de la sección indicada?
    function canEdit(section) {
      return isAdmin()
        || (hasRole()
            && roleData().role == 'editor'
            && (roleData().sections is list)
            && (section in roleData().sections));
    }

    // ── Aprobación de cuentas ──
    function accountData() {
      return get(/databases/$(database)/documents/cuentas/$(request.auth.uid)).data;
    }
    function hasAccount() {
      return request.auth != null
        && exists(/databases/$(database)/documents/cuentas/$(request.auth.uid));
    }
    // ¿Está autorizado el usuario a LEER el contenido?
    //  - admin/editor (rol asignado en consola), o
    //  - cuenta aprobada por el administrador, o
    //  - usuario HEREDADO sin ficha de cuenta (creado en consola antes del registro).
    // Este último caso evita dejar fuera a los usuarios ya existentes. Una vez migrados
    // todos a 'cuentas', puede endurecerse quitando "|| !hasAccount()".
    function isApproved() {
      return request.auth != null
        && ( hasRole()
          || !hasAccount()
          || accountData().estado == 'aprobada' );
    }

    match /guias/{id} {
      allow read:   if isApproved();
      allow create: if canEdit(request.resource.data.section);
      // Al actualizar, debe poder editar tanto la sección actual como la nueva
      // (impide "mover" una guía a una sección sobre la que no se tiene permiso).
      allow update: if canEdit(resource.data.section)
                    && canEdit(request.resource.data.section);
      allow delete: if canEdit(resource.data.section);
    }

    match /roles/{uid} {
      // Cada usuario puede leer su propio rol; cualquier administrador los lee y los gestiona.
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      // La admin PRINCIPAL puede TODO. Un CO-ADMIN (otro administrador) solo gestiona EDITORES:
      // no puede tocar a la principal, ni crear/modificar/eliminar administradores. Así el nivel
      // "administrador" (las llaves de la casa) es exclusivo de la principal, y los co-admins se
      // ocupan de lo operativo (editores, contenido) para que la app siga viva sin ella.
      allow write: if request.auth.uid == 'oHgd0fQBUfQV1NxGKbFHkHNZSWz1'
                   || ( isAdmin()
                        && uid != 'oHgd0fQBUfQV1NxGKbFHkHNZSWz1'
                        && (resource == null || resource.data.role != 'admin')
                        && (request.resource == null || request.resource.data.role != 'admin') );
    }

    // ── Cuentas de usuario y registro de aceptación de términos ──
    // Cada usuario crea su PROPIA ficha al registrarse (estado 'pendiente' y con la
    // aceptación de términos). Solo el admin puede leer todas, aprobar/rechazar o borrar.
    match /cuentas/{uid} {
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.aceptaTerminos == true;
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      // El propietario puede registrar SU aceptación de términos (una sola vez por usuario,
      // válida en cualquier equipo) SIN tocar su estado de aprobación ni otros campos: así un
      // usuario pendiente no puede "auto-aprobarse". Cualquier otro cambio, solo el admin.
      allow update: if isAdmin()
                    || ( request.auth != null
                         && request.auth.uid == uid
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['aceptaTerminos', 'versionTerminos', 'fechaAceptacion'])
                         && request.resource.data.aceptaTerminos == true );
      allow delete: if isAdmin();
    }

    // ── Directorio de usuarios que han iniciado sesión ──
    // Cada usuario registra/actualiza SU PROPIA ficha al entrar (correo, nombre, último acceso).
    // Sirve para que la administradora vea y gestione TODOS los usuarios desde la app, incluidos
    // los creados a mano en la consola (que no tienen ficha en 'cuentas'). Solo el admin los lee.
    match /usuarios/{uid} {
      allow read:   if isAdmin();
      allow write:  if request.auth != null && request.auth.uid == uid;
    }

    // ── Colaboradores acreditados por tema (Aviso Legal) ──
    // La administradora asigna editores; su crédito (nombre + secciones) se publica aquí para
    // que el Aviso Legal —que ve TODO el mundo— refleje quién mantiene cada sección. Lo leen
    // los usuarios autorizados; solo un admin lo escribe.
    match /colaboradores/{uid} {
      allow read:   if isApproved();
      allow write:  if isAdmin();
    }

    // ── Apartados (subtipos) de las guías clínicas, por sección ──
    // Estructura de apartados de cada sección (crear/renombrar/eliminar), efectiva para TODOS.
    // La leen los usuarios autorizados; la escribe quien puede editar ESA sección: el admin
    // (cualquier sección) o el editor asignado a esa sección (misma regla que las guías PDF).
    match /subtipos/{section} {
      allow read:   if isApproved();
      allow write:  if canEdit(section);
    }

    // ── Secciones de guías (título y visibilidad en el menú) ──
    // Editable SOLO por administradores (la principal y los co-admins), NO por editores.
    // Efectiva para todos: renombrar u ocultar una sección del menú de guías.
    match /secciones/{section} {
      allow read:   if isApproved();
      allow write:  if isAdmin();
    }

    // ── Algoritmos interactivos, por sección ──
    // Los lee cualquier usuario autorizado; los crea/edita/borra quien puede editar ESA sección
    // (admin de cualquier sección, o editor de la sección), igual que las guías PDF.
    match /algoritmos/{id} {
      allow read:   if isApproved();
      allow create: if canEdit(request.resource.data.seccion);
      allow update: if canEdit(resource.data.seccion) && canEdit(request.resource.data.seccion);
      allow delete: if canEdit(resource.data.seccion);
    }

    // ── Directorio: contactos personalizados del hospital (listín telefónico) ──
    // Editable SOLO por administradores; efectivo para todos los usuarios autorizados.
    match /directorio/{id} {
      allow read:   if isApproved();
      allow write:  if isAdmin();
    }

    // ── Textos legales (Aviso Legal): solo la admin PRINCIPAL los edita ──
    // Protege la autoría/propiedad intelectual: ningún co-admin puede alterar el texto legal.
    match /textos/{id} {
      allow read:   if isApproved();
      allow write:  if request.auth.uid == 'oHgd0fQBUfQV1NxGKbFHkHNZSWz1';
    }

    // ── Identidad del hospital (nombre, color y demás ajustes de marca) ──
    // Editable por administradores (principal y co-admins); efectiva para todos.
    // Permite que cada hospital personalice el aspecto de la app sin tocar el código.
    match /ajustes/{id} {
      allow read:   if isApproved();
      allow write:  if isAdmin();
    }

    match /config/{doc} {
      // Token de GitHub y similares: solo lo leen admin/editores (para subir PDF).
      // Nunca se escribe desde la app; se gestiona desde la consola.
      allow read:  if isAdmin() || (hasRole() && roleData().role == 'editor');
      allow write: if false;
    }

    // ── Reportes de errores / incidencias ──
    // Cualquier usuario autenticado puede CREAR un reporte (manual o captura automática de
    // un error de JS). Solo el administrador puede leerlos, marcarlos como resueltos o borrarlos.
    match /reportes/{id} {
      allow create: if request.auth != null
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 4000;
      allow read, update, delete: if isAdmin();
    }
  }
}
