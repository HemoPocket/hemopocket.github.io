rules_version = '2';

// ── Reglas de Firestore para HemoPocket ──
// Dos colecciones:
//   roles/{uid}  → { role: "admin" }  ó  { role: "editor", sections: ["bs","th", ...] }
//   guias/{id}   → { section, subtype, name, path, updatedAt, uploadedBy }
//
// Lectura de guías: solo usuarios AUTORIZADOS (admin/editor, cuenta aprobada, o
//   usuario heredado sin ficha de cuenta). Ver función isApproved().
// Escritura de guías: admin (cualquier sección) o editor de ESA sección.
// La colección roles se gestiona desde la consola; el cliente no la escribe.

service cloud.firestore {
  match /databases/{database}/documents {

    function roleData() {
      return get(/databases/$(database)/documents/roles/$(request.auth.uid)).data;
    }
    function hasRole() {
      return request.auth != null
        && exists(/databases/$(database)/documents/roles/$(request.auth.uid));
    }
    function isAdmin() {
      return hasRole() && roleData().role == 'admin';
    }
    // Cualquier editor (de cualquier sección) o administrador. Lo usa el listín
    // telefónico, que no está ligado a una sección concreta de guías.
    function isEditor() {
      return hasRole() && (roleData().role == 'admin' || roleData().role == 'editor');
    }
    // ¿Puede el usuario actual editar guías de la sección indicada?
    function canEdit(section) {
      return isAdmin()
        || (hasRole()
            && roleData().role == 'editor'
            && (roleData().sections is list)
            && (section in roleData().sections));
    }

    // ── Aprobación de cuentas ──
    function accountData() {
      return get(/databases/$(database)/documents/cuentas/$(request.auth.uid)).data;
    }
    function hasAccount() {
      return request.auth != null
        && exists(/databases/$(database)/documents/cuentas/$(request.auth.uid));
    }
    // ¿Está autorizado el usuario a LEER el contenido?
    //  - admin/editor (rol asignado en consola), o
    //  - cuenta aprobada por el administrador, o
    //  - usuario HEREDADO sin ficha de cuenta (creado en consola antes del registro).
    // Este último caso evita dejar fuera a los usuarios ya existentes. Una vez migrados
    // todos a 'cuentas', puede endurecerse quitando "|| !hasAccount()".
    function isApproved() {
      return request.auth != null
        && ( hasRole()
          || !hasAccount()
          || accountData().estado == 'aprobada' );
    }

    match /guias/{id} {
      allow read:   if isApproved();
      allow create: if canEdit(request.resource.data.section);
      // Al actualizar, debe poder editar tanto la sección actual como la nueva
      // (impide "mover" una guía a una sección sobre la que no se tiene permiso).
      allow update: if canEdit(resource.data.section)
                    && canEdit(request.resource.data.section);
      allow delete: if canEdit(resource.data.section);
    }

    match /roles/{uid} {
      // Cada usuario puede leer su propio rol; cualquier administrador los lee y los gestiona.
      allow read:  if request.auth != null && (request.auth.uid == uid || isAdmin());
      // La admin PRINCIPAL puede TODO. Un CO-ADMIN (otro administrador) solo gestiona EDITORES:
      // no puede tocar a la principal, ni crear/modificar/eliminar administradores. Así el nivel
      // "administrador" (las llaves de la casa) es exclusivo de la principal, y los co-admins se
      // ocupan de lo operativo (editores, contenido) para que la app siga viva sin ella.
      allow write: if request.auth.uid == 'oHgd0fQBUfQV1NxGKbFHkHNZSWz1'
                   || ( isAdmin()
                        && uid != 'oHgd0fQBUfQV1NxGKbFHkHNZSWz1'
                        && (resource == null || resource.data.role != 'admin')
                        && (request.resource == null || request.resource.data.role != 'admin') );
    }

    // ── Tokens de notificaciones push (FCM). Cada usuario guarda/borra el SUYO; las Cloud
    // Functions (admin SDK) los leen para avisar a los administradores. Un admin puede leerlos. ──
    match /pushTokens/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // ── Cuentas de usuario y registro de aceptación de términos ──
    // Cada usuario crea su PROPIA ficha al registrarse (estado 'pendiente' y con la
    // aceptación de términos). Solo el admin puede leer todas, aprobar/rechazar o borrar.
    match /cuentas/{uid} {
      allow create: if request.auth != null
                    && request.auth.uid == uid
                    && request.resource.data.estado == 'pendiente'
                    && request.resource.data.aceptaTerminos == true;
      allow read:   if request.auth != null && (request.auth.uid == uid || isAdmin());
      // El propietario puede registrar SU aceptación de términos (una sola vez por usuario,
      // válida en cualquier equipo) SIN tocar su estado de aprobación ni otros campos: así un
      // usuario pendiente no puede "auto-aprobarse". Cualquier otro cambio, solo el admin.
      allow update: if isAdmin()
                    || ( request.auth != null
                         && request.auth.uid == uid
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['aceptaTerminos', 'versionTerminos', 'fechaAceptacion'])
                         && request.resource.data.aceptaTerminos == true );
      allow delete: if isAdmin();
    }

    // ── Registro DURADERO de aceptación del Aviso Legal, por usuario ──
    // Ficha propia de cada usuario (incluidas las cuentas creadas en consola, que NO tienen ficha
    // en 'cuentas'). Permite que la aceptación valga en CUALQUIER equipo y no se vuelva a pedir tras
    // borrar la caché. Cada uno escribe SOLO la suya y siempre con aceptaTerminos=true; el admin las lee.
    match /aceptaciones/{uid} {
      allow read:           if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && request.resource.data.aceptaTerminos == true;
      allow delete:         if isAdmin();
    }

    // ── Directorio de usuarios que han iniciado sesión ──
    // Cada usuario registra/actualiza SU PROPIA ficha al entrar (correo, nombre, último acceso).
    // Sirve para que la administradora vea y gestione TODOS los usuarios desde la app, incluidos
    // los creados a mano en la consola (que no tienen ficha en 'cuentas'). Solo el admin los lee.
    match /usuarios/{uid} {
      allow read:   if isAdmin();
      allow write:  if request.auth != null && request.auth.uid == uid;
    }

    // ── Colaboradores acreditados por tema (Aviso Legal) ──
    // La administradora asigna editores; su crédito (nombre + secciones) se publica aquí para
    // que el Aviso Legal —que ve TODO el mundo— refleje quién mantiene cada sección. Lo leen
    // los usuarios autorizados; solo un admin lo escribe.
    match /colaboradores/{uid} {
      allow read:   if isApproved();
      allow write:  if isAdmin();
    }

    // ── Apartados (subtipos) de las guías clínicas, por sección ──
    // Estructura de apartados de cada sección (crear/renombrar/eliminar), efectiva para TODOS.
    // La leen los usuarios autorizados; la escribe quien puede editar ESA sección: el admin
    // (cualquier sección) o el editor asignado a esa sección (misma regla que las guías PDF).
    match /subtipos/{section} {
      allow read:   if isApproved();
      allow write:  if canEdit(section);
    }

    // ── Secciones de guías (título y visibilidad en el menú) ──
    // Editable SOLO por administradores (la principal y los co-admins), NO por editores.
    // Efectiva para todos: renombrar u ocultar una sección del menú de guías.
    match /secciones/{section} {
      allow read:   if isApproved();
      allow write:  if isAdmin();
    }

    // ── Elementos del menú (calculadoras): visibilidad y nombre, por tema ──
    // Editable por administradores (cualquier campo). Los editores SOLO pueden cambiar el campo
    // 'sub' (la subsección dentro de la sección): no pueden renombrar/ocultar/mover calculadoras.
    // El reparto por sección lo controla la app; aquí se acota el cambio al campo de subsección.
    function _soloSub() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['sub', 'actualizadoPor', 'fechaActualizacion']);
    }
    match /menuitems/{id} {
      allow read:   if isApproved();
      allow create: if isAdmin()
                    || (isEditor() && request.resource.data.keys()
                          .hasOnly(['sub', 'actualizadoPor', 'fechaActualizacion']));
      allow update: if isAdmin() || (isEditor() && _soloSub());
      allow delete: if isAdmin();
    }

    // ── Plantillas de informe (formato del texto que se copia de cada calculadora) ──
    // Un doc por calculadora (id de la vista). Lo leen los usuarios autorizados; lo editan
    // administradores y editores (texto que se refleja en los informes del servicio).
    match /plantillas/{id} {
      allow read:  if isApproved();
      allow write: if isEditor();
    }

    // ── Bloques editables (textos de algoritmos/herramientas fijas, p. ej. neutropenia febril) ──
    // Un doc por bloque. Lo leen los usuarios autorizados; lo editan administradores y editores.
    match /bloques/{id} {
      allow read:  if isApproved();
      allow write: if isEditor();
    }

    // ── Orden de las categorías del menú (reordenar las secciones) ──
    // Editable SOLO por administradores; efectivo para todos.
    match /menuconfig/{id} {
      allow read:   if isApproved();
      // 'orden' sigue siendo solo-admin; 'redaccion' y 'recetas' (asistentes) los pueden editar
      // también los editores del área 'asistentes'.
      allow write:  if isAdmin() || ((id == 'redaccion' || id == 'recetas') && (canEdit('asist_red') || canEdit('asistentes')));
    }

    // ── Check list de ingreso (estructura editable) ──
    // Editable SOLO por administradores; efectivo para todos.
    match /checklists/{id} {
      allow read:   if isApproved();
      allow write:  if isAdmin();
    }

    // ── Esquemas de quimioterapia propios ──
    // Editable SOLO por administradores; efectivo para todos.
    match /qtschemes/{id} {
      allow read:   if isApproved();
      allow write:  if isAdmin() || canEdit('asist_qt') || canEdit('asistentes');
    }

    // ── Algoritmos interactivos, por sección ──
    // Los lee cualquier usuario autorizado; los crea/edita/borra quien puede editar ESA sección
    // (admin de cualquier sección, o editor de la sección), igual que las guías PDF.
    match /algoritmos/{id} {
      allow read:   if isApproved();
      allow create: if canEdit(request.resource.data.seccion);
      allow update: if canEdit(resource.data.seccion) && canEdit(request.resource.data.seccion);
      allow delete: if canEdit(resource.data.seccion);
    }

    // ── Calculadoras propias (puntuaciones/fórmulas), por sección ──
    // Mismas reglas que los algoritmos: las lee cualquier usuario autorizado; las crea/edita/
    // mueve/borra quien puede editar ESA sección (admin de cualquiera, o editor de la sección).
    // Para MOVERLAS hace falta permiso en la sección de origen y en la de destino.
    match /calculadoras/{id} {
      allow read:   if isApproved();
      allow create: if canEdit(request.resource.data.seccion);
      allow update: if canEdit(resource.data.seccion) && canEdit(request.resource.data.seccion);
      allow delete: if canEdit(resource.data.seccion);
    }

    // ── Contenido informativo (notas/fichas), por sección ──
    // Mismas reglas que algoritmos y calculadoras: lo lee cualquier usuario autorizado; lo crea/
    // edita/mueve/borra quien puede editar ESA sección. Mover exige permiso en origen y destino.
    match /infos/{id} {
      allow read:   if isApproved();
      allow create: if canEdit(request.resource.data.seccion);
      allow update: if canEdit(resource.data.seccion) && canEdit(request.resource.data.seccion);
      allow delete: if canEdit(resource.data.seccion);
    }

    // ── Ensayos clínicos / estudios (sección 'ensayos') ──
    // Los lee cualquier usuario autorizado; los gestionan admin y editores de 'ensayos'.
    match /ensayos/{id} {
      allow read:  if isApproved();
      allow write: if canEdit('ensayos');
    }

    // ── Centros / hospitales (multi-hospital) ──
    // Lectura PÚBLICA (solo id + nombre del hospital, no es información sensible): la necesita el
    // desplegable «elige tu hospital» de la pantalla de registro, antes de tener cuenta aprobada.
    // Solo los administradores los crean/editan.
    match /centros/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Registro de cambios / auditoría ──
    // Lo escribe cualquier usuario autorizado al hacer una acción (publicar, eliminar, aprobar…);
    // solo los administradores lo leen. Es INMUTABLE: no se puede modificar ni borrar.
    match /cambios/{id} {
      allow read:   if isAdmin();
      allow create: if isApproved();
      allow update, delete: if false;
    }

    // ── Páginas editadas (override del contenido de vistas existentes) ──
    // Lo lee cualquier usuario autorizado. Lo edita quien puede editar la sección a la que pertenece
    // la página (campo 'seccion'); si la página no tiene sección (vistas generales), solo un admin.
    match /paginas/{id} {
      allow read:   if isApproved();
      allow create: if isAdmin() || (request.resource.data.seccion is string && canEdit(request.resource.data.seccion));
      allow update: if isAdmin() || (resource.data.seccion is string && canEdit(resource.data.seccion)
                                     && request.resource.data.seccion is string && canEdit(request.resource.data.seccion));
      allow delete: if isAdmin() || (resource.data.seccion is string && canEdit(resource.data.seccion));
    }

    // ── Directorio: contactos personalizados del hospital (listín telefónico) ──
    // Editable por administradores y por cualquier editor; efectivo para todos los usuarios autorizados.
    match /directorio/{id} {
      allow read:   if isApproved();
      allow write:  if isEditor();
    }

    // ── Textos legales (Aviso Legal): solo la admin PRINCIPAL los edita ──
    // Protege la autoría/propiedad intelectual: ningún co-admin puede alterar el texto legal.
    match /textos/{id} {
      allow read:   if isApproved();
      allow write:  if request.auth.uid == 'oHgd0fQBUfQV1NxGKbFHkHNZSWz1';
    }

    match /config/{doc} {
      // Token de GitHub y similares: solo lo leen admin/editores (para subir PDF).
      // Nunca se escribe desde la app; se gestiona desde la consola.
      allow read:  if isAdmin() || (hasRole() && roleData().role == 'editor');
      allow write: if false;
    }

    // ── Reportes de errores / incidencias ──
    // Cualquier usuario autenticado puede CREAR un reporte (manual o captura automática de
    // un error de JS). Solo el administrador puede leerlos, marcarlos como resueltos o borrarlos.
    match /reportes/{id} {
      allow create: if request.auth != null
                    && request.resource.data.texto is string
                    && request.resource.data.texto.size() > 0
                    && request.resource.data.texto.size() <= 4000;
      allow read, update, delete: if isAdmin();
    }
  }
}
